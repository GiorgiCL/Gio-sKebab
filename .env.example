# Copy values into your shell environment; Spring Boot does not load this file automatically.
# Local PostgreSQL only. Create this database and user yourself before running the app.
DB_URL=jdbc:postgresql://localhost:5432/gios_kebab
DB_USERNAME=gios_kebab
DB_PASSWORD=replace-with-local-password
RESTAURANT_TIME_ZONE=Europe/Vilnius
# Production additionally requires SPRING_PROFILES_ACTIVE=prod and explicit DB_URL/DB_USERNAME/DB_PASSWORD.
