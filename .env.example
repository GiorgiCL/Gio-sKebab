# Copy values into your shell environment; Spring Boot does not load this file automatically.
# Local PostgreSQL only. Create this database and user yourself before running the app.
DB_URL=jdbc:postgresql://localhost:5432/gios_kebab
DB_USERNAME=gios_kebab
DB_PASSWORD=replace-with-local-password
RESTAURANT_TIME_ZONE=Europe/Vilnius
# Production additionally requires SPRING_PROFILES_ACTIVE=prod and explicit DB_URL/DB_USERNAME/DB_PASSWORD.

# Optional production PostHog Logs via the OpenTelemetry Java agent; see docs/POSTHOG_LOGS.md.
# These are examples only. Keep the real project token in deployment environment/secrets.
POSTHOG_LOGS_ENABLED=false
# OTEL_SERVICE_NAME=gios-kebab-backend
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
# OTEL_TRACES_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://eu.i.posthog.com/i/v1/logs
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=Authorization=Bearer%20<eu-project-token>
# OTEL_INSTRUMENTATION_LOGBACK_APPENDER_ENABLED=false
